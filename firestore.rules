rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRegistered() {
      return isAuthenticated()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsCharacter(characterId) {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/characters/$(characterId))
          && get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;
    }

    function noPrivilegeEscalation() {
      return resource == null 
        ? (!('privilegeLevel' in request.resource.data) && !('role' in request.resource.data))
        : ((!('privilegeLevel' in request.resource.data) || !('privilegeLevel' in resource.data) || request.resource.data.privilegeLevel == resource.data.privilegeLevel)
           && (!('role' in request.resource.data) || !('role' in resource.data) || request.resource.data.role == resource.data.role));
    }

    // Validação estrita para Gate 4: cliente NUNCA cria bot!
    function isRealPlayerCreation(data) {
      return data.playerType == 'real' 
          && data.entityType == 'player'
          && data.ownerUid == request.auth.uid;
    }

    // Validação estrita para Gate 2: campos de identidade são imutáveis após CREATE
    function immutableCharacterFieldsUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid
          && (!('accountId' in resource.data) || !('accountId' in request.resource.data) || request.resource.data.accountId == resource.data.accountId)
          && request.resource.data.characterId == resource.data.characterId
          && request.resource.data.entityType == resource.data.entityType
          && request.resource.data.playerType == resource.data.playerType
          && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    function isServerAdmin() {
      return isAuthenticated() && (
        (('email' in request.auth.token) && request.auth.token.email in ['duuh.alaminos@gmail.com', 'eduardol.alaminos@gmail.com']) ||
        (('admin' in request.auth.token) && request.auth.token.admin == true)
      );
    }

    // ─── Contas de Usuário (accounts) ────────────────────────────────────────
    match /accounts/{accountId} {
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isServerAdmin());
      allow create: if isServerAdmin() || (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && noPrivilegeEscalation());
      allow update: if isServerAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid 
                    && request.resource.data.ownerUid == resource.data.ownerUid 
                    && (!('accountId' in resource.data) || request.resource.data.accountId == resource.data.accountId) 
                    && noPrivilegeEscalation());
      allow delete: if isServerAdmin(); // Permite exclusão exclusivamente em manutenção administrativa
    }

    // ─── Reserva Canônica de Nomes (character_names) ─────────────────────────
    match /character_names/{nameLower} {
      allow read: if isAuthenticated();
      // Criação atômica: só permite criar se não existir previamente ou se admin
      allow create: if isServerAdmin() || (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isServerAdmin(); // Nome reservado só pode ser alterado por admin
      allow delete: if isServerAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
    }

    // ─── Identidade Canônica do Personagem (characters) ───────────────────────
    match /characters/{characterId} {
      allow read: if isAuthenticated();
      // CREATE: valida request.resource.data (Gate 3 e Gate 4) ou admin
      allow create: if isServerAdmin() || (isAuthenticated() && isRealPlayerCreation(request.resource.data) && noPrivilegeEscalation());
      // UPDATE: valida resource.data vs request.resource.data (Gate 2) ou admin
      allow update: if isServerAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid 
                    && immutableCharacterFieldsUnchanged() 
                    && noPrivilegeEscalation());
      allow delete: if isServerAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
    }

    // ─── Presença em Tempo Real (presence) — Gate 1 ──────────────────────────
    match /presence/{characterId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isServerAdmin() || (isAuthenticated() 
                    && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
                    && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isServerAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
    }

    // ─── Relações de Amizade (friends) ───────────────────────────────────────
    match /friends/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (isRegistered()
                    && request.resource.data.characterAId != request.resource.data.characterBId
                    && (ownsCharacter(request.resource.data.characterAId) || ownsCharacter(request.resource.data.characterBId)));
      allow update: if isServerAdmin();
      allow delete: if isServerAdmin() || (isRegistered()
                    && (ownsCharacter(resource.data.characterAId) || ownsCharacter(resource.data.characterBId)));
    }

    match /friend_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isServerAdmin();
    }

    // ─── Mentoria Oficial (mentorships) ─────────────────────────────────────
    match /mentorships/{mentorshipId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (isRegistered() && ownsCharacter(request.resource.data.apprenticeCharacterId));
      allow update, delete: if isServerAdmin() || (isRegistered() && ownsCharacter(resource.data.apprenticeCharacterId));
    }

    match /mentorship_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isServerAdmin();
    }

    // ─── Sistema de Indicação / Referral (referrals) ─────────────────────────
    match /referrals/{referralId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (isRegistered() && request.resource.data.invitedUid == request.auth.uid);
      allow update, delete: if isServerAdmin();
    }

    // ─── Lista de Bloqueio (blocks) ──────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isServerAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isServerAdmin();
    }

    // ─── Clãs Imperiais e Membros ────────────────────────────────────────────
    match /clans/{clanId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (
        isRegistered()
        && request.resource.data.keys().hasOnly([
          'name', 'nameKey', 'description', 'crestId', 'leaderUid', 'recruitmentOpen',
          'memberCap', 'level', 'allianceId', 'territoryIds', 'hallLevel',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'nameKey', 'description', 'crestId', 'leaderUid', 'recruitmentOpen',
          'memberCap', 'level', 'allianceId', 'territoryIds', 'hallLevel',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 24
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() >= 3
        && request.resource.data.nameKey.size() <= 48
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.crestId is string
        && request.resource.data.crestId.size() <= 40
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.recruitmentOpen is bool
        && request.resource.data.memberCap == 50
        && request.resource.data.level == 1
        && request.resource.data.allianceId == null
        && request.resource.data.territoryIds == []
        && request.resource.data.hallLevel == 0
        && getAfter(/databases/$(database)/documents/clan_names/$(request.resource.data.nameKey)).data.clanId == clanId
        && getAfter(/databases/$(database)/documents/clan_members/$(request.auth.uid)).data.clanId == clanId
        && getAfter(/databases/$(database)/documents/clan_members/$(request.auth.uid)).data.role == 'leader'
      );
      // A liderança pode editar apenas o texto de apresentação, recrutamento e brasão do clã.
      // Nível, membros, território, hall e alianças exigirão operações autoritativas.
      allow update: if isServerAdmin() || (
        isRegistered()
        && resource.data.leaderUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'recruitmentOpen', 'crestId', 'updatedAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.recruitmentOpen is bool
        && (!('crestId' in request.resource.data) || (request.resource.data.crestId is string && request.resource.data.crestId.size() <= 40))
      );
      allow delete: if isServerAdmin();
    }

    match /clan_members/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (
        isRegistered()
        && membershipId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'clanId', 'role', 'displayName', 'joinedAt'])
        && request.resource.data.keys().hasAll(['uid', 'clanId', 'role', 'displayName', 'joinedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.clanId is string
        && (
          (request.resource.data.role == 'leader'
            && getAfter(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.leaderUid == request.auth.uid)
          ||
          (request.resource.data.role == 'member'
            && get(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.recruitmentOpen == true)
        )
      );
      allow update: if isServerAdmin();
      allow delete: if isServerAdmin() || (
        isRegistered()
        && (
          (membershipId == request.auth.uid && resource.data.uid == request.auth.uid && resource.data.role == 'member')
          ||
          (get(/databases/$(database)/documents/clans/$(resource.data.clanId)).data.leaderUid == request.auth.uid && resource.data.role == 'member')
        )
      );
    }

    match /clan_names/{nameKey} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (
        isRegistered()
        && request.resource.data.keys().hasOnly(['clanId', 'nameKey', 'createdBy'])
        && request.resource.data.keys().hasAll(['clanId', 'nameKey', 'createdBy'])
        && request.resource.data.nameKey == nameKey
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.clanId is string
        && getAfter(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.nameKey == nameKey
        && getAfter(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.leaderUid == request.auth.uid
      );
      allow update, delete: if isServerAdmin();
    }

    // ─── Snapshot Competitivo de Rankings (pvp_rankings) ────────────────────
    match /pvp_rankings/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (isRegistered() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isServerAdmin() || (isRegistered()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isServerAdmin();
    }

    // ─── Inscrições na Grand Olympiad ───────────────────────────────────────
    match /olympiad_registrations/{regId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isServerAdmin();
    }

    // ─── Mercado Central de Giran — Anúncios P2P ────────────────────────────
    match /market_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isServerAdmin() || (
        isRegistered()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.isPlayerListing == true
        && request.resource.data.isSold != true
      );
      allow update: if isServerAdmin() || (
        isRegistered() && (
          // Caso 1: Vendedor atualiza seu próprio anúncio sem alterar o sellerId
          (resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == resource.data.sellerId)
          ||
          // Caso 2: Comprador registra compra atômica em escrow
          (
            resource.data.isSold != true
            && request.resource.data.isSold == true
            && request.resource.data.status == 'SOLD'
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.pricePerUnit == resource.data.pricePerUnit
            && request.resource.data.totalPrice == resource.data.totalPrice
            && request.resource.data.currency == resource.data.currency
            && request.resource.data.quantity == resource.data.quantity
            && request.resource.data.item == resource.data.item
          )
        )
      );
      allow delete: if isServerAdmin() || (isRegistered() && resource.data.sellerId == request.auth.uid);
    }

    // ─── Mercado Central de Giran — Registro de Vendas ──────────────────────
    match /market_sales/{sellerKey} {
      allow read: if isAuthenticated();
      allow create, update: if isServerAdmin() || isRegistered();
      allow delete: if isServerAdmin();
    }

    // ─── Metadados Globais do Servidor ──────────────────────────────────────
    match /server_meta/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if isServerAdmin();
    }

    // ─── Logs de Auditoria do Sistema ───────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isServerAdmin();
      allow create: if isAuthenticated();
      allow delete: if isServerAdmin();
    }

    // ─── Coleção Legada de Usuários (Fase 1 de Migração) ─────────────────────
    // Mantida para compatibilidade transitória não-destrutiva
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if (isOwner(userId) && noPrivilegeEscalation()) || isServerAdmin();
      allow delete: if (isAuthenticated() && isOwner(userId)) || isServerAdmin();
    }
  }
}
