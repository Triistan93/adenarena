rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    // Usuário tem qualquer sessão ativa (inclui anônimos)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuário registrado (Google ou Email — NÃO anônimo)
    function isRegistered() {
      return isAuthenticated()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // O usuário é dono do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Bloqueia tentativa de escalar privilégios via client-side write
    function noPrivilegeEscalation() {
      return resource == null 
        ? (!('privilegeLevel' in request.resource.data) && !('role' in request.resource.data))
        : ((!('privilegeLevel' in request.resource.data) || !('privilegeLevel' in resource.data) || request.resource.data.privilegeLevel == resource.data.privilegeLevel)
           && (!('role' in request.resource.data) || !('role' in resource.data) || request.resource.data.role == resource.data.role));
    }

    // ─── Coleção de Usuários ─────────────────────────────────────────────────
    // Saves, Rankings, Matchmaking, Perfis Públicos e Status PvP.
    // • Leitura: qualquer autenticado (necessário para rankings e matchmaking).
    // • Escrita: somente o próprio usuário — e NUNCA pode escrever
    //   privilegeLevel ou role (esses campos são gerenciados pelo Firebase Console).
    match /users/{userId} {
      allow read:  if isAuthenticated();
      allow write: if isOwner(userId) && noPrivilegeEscalation();
    }

    // ─── Clãs Imperiais e Guerras ────────────────────────────────────────────
    // Leitura pública para qualquer autenticado.
    // Criação/Atualização/Exclusão requer conta registrada.
    match /clans/{clanId} {
      allow read:  if isAuthenticated();
      allow write: if isRegistered();
    }

    // ─── Mercado Central de Giran — Anúncios P2P ────────────────────────────
    // • Leitura e negociação entre jogadores autenticados (inclui anônimos).
    match /market_listings/{listingId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ─── Mercado Central de Giran — Registro de Vendas ──────────────────────
    match /market_sales/{sellerKey} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Metadados Globais do Servidor e Metas Comunitárias ──────────────────
    match /server_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}

